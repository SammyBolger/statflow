# Copy this file to `.env` and fill in values as needed.
# The real `.env` is gitignored — never commit secrets.

# Optional: enables closing-line ingestion + the Model vs Market
# dashboard chart. Free tier from https://the-odds-api.com is 500
# requests/month, enough for one pull per day.
# ODDS_API_KEY=your_key_here

# Optional overrides for R2 sync (only needed when running the daily flow
# outside GH Actions and against a live R2 bucket).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=statflow
